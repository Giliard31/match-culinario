<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MatchCulinário</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#ff6b6b">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f7f6; margin: 0; padding: 20px; text-align: center; }
        .container { max-width: 500px; margin: 0 auto; background: white; padding: 20px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        h1 { color: #ff6b6b; margin-bottom: 5px; }
        p { color: #666; }
        .btn { background: #ff6b6b; color: white; border: none; padding: 15px 25px; font-size: 16px; border-radius: 50px; cursor: pointer; width: 100%; margin-top: 15px; font-weight: bold; }
        .btn:active { background: #e05555; }
        #resultado { margin-top: 20px; text-align: left; }
        .card { background: #fff8f8; border-left: 4px solid #ff6b6b; padding: 10px; margin-bottom: 10px; border-radius: 8px; }
    </style>
</head>
<body>

    <div class="container">
        <h1>MatchCulinário 🍳</h1>
        <p>O que tem na sua geladeira hoje?</p>
        
        <input type="file" id="cameraInput" accept="image/*" capture="environment" style="display: none;">
        
        <button class="btn" onclick="document.getElementById('cameraInput').click()">📸 Escanear Geladeira</button>

        <div id="resultado"></div>
    </div>

    <script>
        document.getElementById('cameraInput').addEventListener('change', async function(e) {
            const resultadoDiv = document.getElementById('resultado');
            resultadoDiv.innerHTML = "<p>Analisando ingredientes com IA...</p>";

            // Simulando o envio da foto para o backend
            setTimeout(async () => {
                const resposta = await fetch('/api/receitas', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ingredientes: ["Ovo", "Tomate", "Queijo"] })
                });
                const receitas = await resposta.json();

                let html = "<h3>Receitas Encontradas:</h3>";
                receitas.forEach(r => {
                    html += `<div class="card"><strong>${r.nome}</strong><br><small>Tempo: ${r.tempo} | Compatibilidade: ${r.compatibilidade}</small></div>`;
                });
                resultadoDiv.innerHTML = html;
            }, 1500);
        });
    </script>
</body>
</html>
